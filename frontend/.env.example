# Only needed for production builds (npm run build / npm run preview).
# In dev (npm run dev), Vite's proxy in vite.config.js forwards /api to
# http://localhost:5000 automatically, so this can stay unset.
#
# Set this to your deployed backend's full API URL, then build:
#   VITE_API_URL=https://api.example.com/api npm run build
VITE_API_URL=
